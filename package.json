{
  "name": "pi-autosuggestions",
  "version": "0.7.9",
  "description": "zsh-autosuggestions-style ghost completions for the pi coding agent — history-based inline suggestions, path completion in bash mode, blinking beam cursor",
  "keywords": [
    "pi-package",
    "pi",
    "autocomplete",
    "completions",
    "autosuggestions",
    "zsh"
  ],
  "license": "MIT",
  "author": "Andrew Mahoney-Fernandes <0xPlayerOne>",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "sideEffects": false,
  "main": "./dist/autosuggestions.js",
  "types": "./dist/autosuggestions.d.ts",
  "exports": {
    ".": {
      "types": "./dist/autosuggestions.d.ts",
      "default": "./dist/autosuggestions.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/autosuggestions.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --test test/package.test.mjs",
    "pretest": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xPlayerOne/pi-autosuggestions.git"
  },
  "homepage": "https://github.com/0xPlayerOne/pi-autosuggestions#readme",
  "bugs": {
    "url": "https://github.com/0xPlayerOne/pi-autosuggestions/issues"
  }
}
