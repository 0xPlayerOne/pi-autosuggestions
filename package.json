  "description": "zsh-autosuggestions-style ghost completions for the pi coding agent — history-based inline suggestions, path completion in bash mode, blinking beam cursor",
  "keywords": [
    "pi-package",
    "pi",
    "autocomplete",
    "completions",
    "autosuggestions",
    "zsh"
  ],
  "license": "MIT",
